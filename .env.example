# === Database ===
# DATABASE_URL=postgresql://postgres:secret@localhost:5432/nosent?sslmode=require
DATABASE_URL=postgresql://postgres:secret@localhost:5432/nosent?sslmode=disable
# OR use individual vars for local dev:
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=whatsapp_broadcast
# DB_PORT=5432

# === Server ===
PORT=8080
ENV=development

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# === WhatsApp ===
# Path to SQLite file that stores the WA session
WA_DB_PATH=./wa_session.db

ADMIN_1=
ADMIN_1_PASSWORD=

ADMIN_2=
ADMIN_2_PASSWORD=

ADMIN_3=
ADMIN_3_PASSWORD=

ADMIN_4=
ADMIN_4_PASSWORD=


ADMIN_COUNT=4