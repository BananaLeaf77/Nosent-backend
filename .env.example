# === Database ===
DATABASE_URL=postgresql://postgres:secret@localhost:5432/nosent?sslmode=require
# OR use individual vars for local dev:
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=whatsapp_broadcast
# DB_PORT=5432

# === Server ===
PORT=8080
ENV=development

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Account Collections
ADMIN=
ADMIN_PASSWORD=

ADMIN2=
ADMIN2_PASSWORD=

JWT_SECRET=